{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "on-coders-mikrotiknoc",
  "version": "0.5.0",
  "identifier": "com.on-coders.mikrotiknoc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "On Coder's MikroTik NOC",
        "width": 1024,
        "height": 768,
        "minWidth": 400,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ris3TwO/on-coders-mikrotik-noc/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGQ0NCNUQ4RTIxQjU5RUMKUldUc1dSdmkyTFhNandQTjZ1UHVBNWxSQkRVZHg2UzJZT2F5anN6Y2JoVU1MdUwwazYvaERqUkwK"
    }
  }
}
